# Port the MCP HTTP server listens on
PORT=3000

# AWS region for Bedrock (also picked up from your normal AWS config/profile)
AWS_REGION=us-east-1

# Bedrock model id to use for daily-summary generation
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# Optional: override where the JSON data store lives
# DATA_FILE=./data/store.json
