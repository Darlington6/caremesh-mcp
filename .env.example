# Port the MCP HTTP server listens on
PORT=3000

# AWS region for Bedrock (also picked up from your normal AWS config/profile)
AWS_REGION=us-east-1

# Bedrock model id to use for daily-summary generation
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# DynamoDB Local endpoint for local dev/testing (docker run -p 8000:8000 amazon/dynamodb-local).
# Leave unset in a real deployment. The AWS SDK then talks to real regional DynamoDB using the
# task's IAM role, and tables must already be provisioned (see README).
DYNAMODB_ENDPOINT=http://localhost:8000

# Optional: override the DynamoDB table names (useful for test/demo isolation)
# CHECKINS_TABLE=caremesh-checkins
# MEDICATION_TABLE=caremesh-medication-events
# TASKS_TABLE=caremesh-care-tasks

# Optional: require `Authorization: Bearer <token>` on every /mcp request. Left unset locally so
# MCP Inspector/the demo script work with zero setup. A real deployment should always set this
# (see README's Deploying section for how to inject it as a secret rather than plaintext).
# MCP_AUTH_TOKEN=
